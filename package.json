{
  "name": "next-chapter-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build:web": "expo export --platform web",
    "test:db": "tsx --test tests/database/*.test.ts",
    "test:supabase": "node --env-file-if-exists=.env scripts/verify-supabase.mjs",
    "evidence": "node scripts/save-evidence.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/metro-runtime": "~57.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.0.0",
    "expo": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-image-picker": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
